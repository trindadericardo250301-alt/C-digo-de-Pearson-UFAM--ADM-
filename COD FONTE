# ============================================================
# FUNÇÃO PARA LOCALIZAR MARCADORES
# ============================================================

def encontrar_marcadores(texto, lista):
    encontrados = []

    texto_limpo = normalizar(texto)

    for termo in lista:
        termo_limpo = normalizar(termo)

        if termo_limpo in texto_limpo:
            encontrados.append(termo)

    return encontrados


# ============================================================
# FUNÇÃO PRINCIPAL DE CLASSIFICAÇÃO
# ============================================================

def classificar_contexto(texto):

    texto_limpo = normalizar(texto)

    # ----------------------------------------
    # 1. RESPOSTAS NÃO CLASSIFICÁVEIS
    # ----------------------------------------

    for expressao in nao_classificaveis:

        expressao_limpa = normalizar(expressao)

        # Aqui exigimos que a resposta seja curta
        # para evitar classificar textos longos erroneamente
        if expressao_limpa == texto_limpo:

            return (
                "NÃO CLASSIFICÁVEL",
                f"Resposta sem posicionamento: {expressao}"
            )

    # ----------------------------------------
    # 2. ENCONTRAR MARCADORES
    # ----------------------------------------

    positivos = encontrar_marcadores(
        texto,
        marcadores_positivos
    )

    negativos = encontrar_marcadores(
        texto,
        marcadores_negativos
    )

    condicionais = encontrar_marcadores(
        texto,
        marcadores_condicionais
    )

    # ----------------------------------------
    # 3. CLASSIFICAÇÃO
    # ----------------------------------------

    # Há condição explícita sobre como usar IA
    if condicionais:

        justificativa = (
            "Uso condicionado/equilibrado. "
            "Marcadores: "
            + ", ".join(condicionais)
        )

        return "POSITIVA/CONDICIONAL", justificativa


    # Há aspectos positivos E negativos
    if positivos and negativos:

        justificativa = (
            "Apresenta simultaneamente elementos "
            "positivos e negativos. "
            "Positivos: "
            + ", ".join(positivos)
            + " | Negativos: "
            + ", ".join(negativos)
        )

        return "MISTA/AMBIVALENTE", justificativa


    # Predomínio negativo
    if negativos:

        justificativa = (
            "Marcadores de risco/perda: "
            + ", ".join(negativos)
        )

        return "NEGATIVA", justificativa


    # Predomínio positivo
    if positivos:

        justificativa = (
            "Marcadores de preservação/valorização: "
            + ", ".join(positivos)
        )

        return "POSITIVA", justificativa


    # Nenhum marcador suficiente
    return (
        "NEUTRA/INDEFINIDA",
        "Nenhum marcador contextual suficiente."
    )


